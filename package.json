{
  "name": "blockinsta",
  "version": "2.2.0",
  "private": true,
  "description": "A privacy-friendly WebExtension that blocks infinite Instagram Reels, ends Home, and removes the idle Search discovery grid.",
  "scripts": {
    "icons": "node scripts/generate-icons.js",
    "lint": "node scripts/lint.js",
    "test": "node --test",
    "smoke:chromium": "node scripts/smoke-chrome.js",
    "validate": "node scripts/validate-extension.js && node scripts/validate-orion.js",
    "validate:orion": "node scripts/validate-orion.js",
    "check": "npm run lint && npm test && npm run validate",
    "package": "node scripts/package-extension.js",
    "package:orion": "node scripts/package-orion.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED"
}

