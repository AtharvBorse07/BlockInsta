{
  "manifest_version": 3,
  "name": "BlockInsta for Orion",
  "version": "2.2.0",
  "description": "Block endless Instagram Reels, limit Home, and remove Search discovery in Orion without relying on background APIs.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://instagram.com/*",
    "*://*.instagram.com/*"
  ],
  "action": {
    "default_title": "BlockInsta",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://instagram.com/*",
        "*://*.instagram.com/*"
      ],
      "js": [
        "orion.js",
        "compatibility.js",
        "shared/settings.js",
        "shared/settings-storage.js",
        "shared/routes.js",
        "shared/feed-policy.js",
        "content/feed-guard.js",
        "shared/search-policy.js",
        "content/search-guard.js",
        "content/instagram.js"
      ],
      "css": [
        "content/instagram.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png",
    "256": "icons/icon-256.png",
    "512": "icons/icon-512.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked/blocked.html",
        "blocked/blocked.css",
        "blocked/blocked.js"
      ],
      "matches": [
        "*://instagram.com/*",
        "*://*.instagram.com/*"
      ]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  }
}
